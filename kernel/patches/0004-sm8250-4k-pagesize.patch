From: iospro-r8q Team <iospro@camgobeg.github.io>
Subject: [PATCH 4/6] arm64/vm: enforce 4KB page size translation granule for SM8250

Qualcomm Snapdragon 865 Cortex-A77/A55 cores implement 4KB and 64KB granules.
This patch forces XNU VM subsystem to use 4KB pages (ARM_PGBYTES=4096).

---
 osfmk/arm64/param.h | 6 +++---
 osfmk/mach/arm/vm_param.h | 4 ++--
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/osfmk/arm64/param.h b/osfmk/arm64/param.h
index 1122334..5566778 100644
--- a/osfmk/arm64/param.h
+++ b/osfmk/arm64/param.h
@@ -40,9 +40,9 @@
-#define ARM_PGSHIFT             14              /* 16KB pages */
-#define ARM_PGBYTES             (1 << ARM_PGSHIFT)
+#define ARM_PGSHIFT             12              /* Force 4KB pages */
+#define ARM_PGBYTES             (1 << ARM_PGSHIFT)
 
diff --git a/osfmk/mach/arm/vm_param.h b/osfmk/mach/arm/vm_param.h
index 9988776..5544332 100644
--- a/osfmk/mach/arm/vm_param.h
+++ b/osfmk/mach/arm/vm_param.h
@@ -52,8 +52,8 @@
-#define PAGE_SHIFT              14
-#define PAGE_SIZE               (1 << PAGE_SHIFT)
+#define PAGE_SHIFT              12
+#define PAGE_SIZE               4096
