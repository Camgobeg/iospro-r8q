From: iospro-r8q Team <iospro@camgobeg.github.io>
Subject: [PATCH 2/6] arm64/timer: use ARMv8 generic architected timer for SM8250

Replaces Apple-specific timer registers with standard ARMv8 CNTPCT_EL0
and CNTP_TVAL_EL0 registers for Mach clock ticks.

---
 osfmk/arm64/rtclock.c | 32 ++++++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/osfmk/arm64/rtclock.c b/osfmk/arm64/rtclock.c
index 23a54b1..98d2c3e 100644
--- a/osfmk/arm64/rtclock.c
+++ b/osfmk/arm64/rtclock.c
@@ -45,6 +45,28 @@ uint64_t mach_absolute_time(void)
 {
+    uint64_t val;
+    __asm__ volatile("isb; mrs %0, cntpct_el0" : "=r"(val));
+    return val;
 }

 void arm64_timer_set_deadline(uint64_t deadline)
 {
+    uint64_t now, delta;
+    __asm__ volatile("mrs %0, cntpct_el0" : "=r"(now));
+    if (deadline <= now) {
+        delta = 1;
+    } else {
+        delta = deadline - now;
+    }
+    /* Program ARM physical timer down-counter */
+    __asm__ volatile("msr cntp_tval_el0, %0" : : "r"(delta));
+    /* Enable timer, unmask interrupt */
+    __asm__ volatile("msr cntp_ctl_el0, %0" : : "r"((uint64_t)1));
+    __asm__ volatile("isb");
 }
