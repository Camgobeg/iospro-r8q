# Machine Configuration for Apple XNU on Qualcomm SM8250 (r8q)
MACHINE="ARM64"
TARGET_DEVICE="r8q"
TARGET_SOC="SM8250"
ARCH_CONFIGS="ARM64"
CONFIG_EMBEDDED=1
CONFIG_ARM_ARCH=8
CONFIG_GICV3=1
CONFIG_PSCI=1
CONFIG_PAGE_SIZE_4K=1
CONFIG_SIMPLEFB=1
CONFIG_SECURE_ENCLAVE_STUB=1
CONFIG_CODE_SIGNING_ENFORCE=0
KERNEL_BUILD_CMDLINE="console=simplefb -v debug=0x14e cs_enforcement=0"
